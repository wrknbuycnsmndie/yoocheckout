{
    "name": "@wrknbuycnsmndie/yoo-checkout",
    "version": "1.1.8",
    "description": "Yoo.Checkout API v3 (i forked that from @a2seven/yoo-checkout to keep deps updated)",
    "main": "build/public-api.js",
    "module": "build/public-api.mjs",
    "types": "build/public-api.d.ts",
    "exports": {
        ".": {
            "types": "./build/public-api.d.ts",
            "import": "./build/public-api.mjs",
            "require": "./build/public-api.js"
        }
    },
    "files": [
        "build"
    ],
    "keywords": [
        "Yandex.Checkout",
        "Yoo.Checkout",
        "Yandex.Kassa",
        "Yoo.Kassa",
        "Юкаса",
        "YooKass",
        "Kassa",
        "payment processing",
        "credit cards",
        "api"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wrknbuycnsmndie/yoocheckout.git"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "author": "wkrnbuycnsmndie <a_chapala@mail.ru> (https://worknbuyconsumendie.tech/)",
    "license": "MIT",
    "scripts": {
        "build": "tsup lib/public-api.ts --format cjs,esm --dts --clean --out-dir build",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:unit": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.12.2",
        "axios-mock-adapter": "^2.1.0",
        "eslint": "^10.0.1",
        "tsup": "^8.5.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vitest": "^4.1.4"
    },
    "dependencies": {
        "axios": "^1.15.0",
        "uuid": "^11.1.0"
    },
    "bugs": {
        "url": "https://github.com/wrknbuycnsmndie/yoocheckout/issues"
    },
    "homepage": "https://github.com/wrknbuycnsmndie/yoocheckout#readme"
}
